FROM python:3.12-slim
WORKDIR /app
COPY deployment/requirements-api.txt ./requirements-api.txt
RUN pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements-api.txt
COPY backend ./backend
COPY ml/customer_demo.py ./ml/customer_demo.py
COPY ml/__init__.py ./ml/__init__.py
COPY data/transactions_synthetic.csv ./data/transactions_synthetic.csv
COPY models/merchant/transformer ./models/merchant/transformer
COPY reports/merchant_evaluation.json reports/calibration_evaluation.json ./reports/
COPY api.py index.html script.js styles.css logo.png ./
ENV FINANCE_CLASSIFIER=transformer FINANCE_MODEL_PATH=/app/models/merchant/transformer FINANCE_PUBLIC_DEMO=1 FINANCE_HOST=0.0.0.0
CMD ["python","api.py"]
